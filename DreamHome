-- Hapus tabel jika sudah ada agar bisa dijalankan dari ulang (opsional)
DROP TABLE IF EXISTS Viewing CASCADE;
DROP TABLE IF EXISTS Registration CASCADE;
DROP TABLE IF EXISTS PropertyForRent CASCADE;
DROP TABLE IF EXISTS PrivateOwner CASCADE;
DROP TABLE IF EXISTS Client CASCADE;
DROP TABLE IF EXISTS Staff CASCADE;
DROP TABLE IF EXISTS Branch CASCADE;

-- 1. Tabel Branch
CREATE TABLE Branch (
    branchNo VARCHAR(10) PRIMARY KEY,
    street VARCHAR(50),
    city VARCHAR(30),
    postcode VARCHAR(10)
);

-- 2. Tabel Staff
CREATE TABLE Staff (
    staffNo VARCHAR(10) PRIMARY KEY,
    fName VARCHAR(20),
    lName VARCHAR(20),
    position VARCHAR(20),
    sex CHAR(1),
    DOB DATE,
    salary DECIMAL(10, 2),
    branchNo VARCHAR(10),
    FOREIGN KEY (branchNo) REFERENCES Branch(branchNo)
);

-- 3. Tabel PrivateOwner
CREATE TABLE PrivateOwner (
    ownerNo VARCHAR(10) PRIMARY KEY,
    fName VARCHAR(20),
    lName VARCHAR(20),
    address VARCHAR(100),
    telNo VARCHAR(20)
);

-- 4. Tabel Client
CREATE TABLE Client (
    clientNo VARCHAR(10) PRIMARY KEY,
    fName VARCHAR(20),
    lName VARCHAR(20),
    telNo VARCHAR(20),
    prefType VARCHAR(20),
    maxRent DECIMAL(10, 2)
);

-- 5. Tabel PropertyForRent
CREATE TABLE PropertyForRent (
    propertyNo VARCHAR(10) PRIMARY KEY,
    street VARCHAR(50),
    city VARCHAR(30),
    postcode VARCHAR(10),
    type VARCHAR(20),
    rooms INT,
    rent DECIMAL(10, 2),
    ownerNo VARCHAR(10),
    staffNo VARCHAR(10),
    branchNo VARCHAR(10),
    FOREIGN KEY (ownerNo) REFERENCES PrivateOwner(ownerNo),
    FOREIGN KEY (staffNo) REFERENCES Staff(staffNo),
    FOREIGN KEY (branchNo) REFERENCES Branch(branchNo)
);

-- 6. Tabel Viewing
CREATE TABLE Viewing (
    clientNo VARCHAR(10),
    propertyNo VARCHAR(10),
    viewDate DATE,
    comment VARCHAR(100),
    PRIMARY KEY (clientNo, propertyNo),
    FOREIGN KEY (clientNo) REFERENCES Client(clientNo),
    FOREIGN KEY (propertyNo) REFERENCES PropertyForRent(propertyNo)
);

-- 7. Tabel Registration
CREATE TABLE Registration (
    clientNo VARCHAR(10),
    branchNo VARCHAR(10),
    staffNo VARCHAR(10),
    dateJoined DATE,
    PRIMARY KEY (clientNo, branchNo),
    FOREIGN KEY (clientNo) REFERENCES Client(clientNo),
    FOREIGN KEY (branchNo) REFERENCES Branch(branchNo),
    FOREIGN KEY (staffNo) REFERENCES Staff(staffNo)
);

